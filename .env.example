# Copy to .env and fill in. Never commit .env.

# Your public address, with https:// and no trailing slash.
SITE_URL=https://missionabundance.com
PORT=3000
NODE_ENV=production

# Random secret for sessions. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Stripe (use sk_test_... first, then live keys)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From the webhook endpoint you create for https://YOUR-SITE/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Set to 1 only after you add your Terms URL in Stripe Dashboard > Settings > Public details
STRIPE_REQUIRE_TOS=0
# Shown on the site's buttons
PRICE_LABEL=$9

# Shown in the footer, policies and emails
SUPPORT_EMAIL=support@missionabundance.com

# Optional: email sending. Without it, buyers still set their password right after
# checkout, and emails are printed to the server log instead of sent.
# Format: smtp://USER:PASSWORD@HOST:587  (works with Resend, Postmark, Mailgun, SES, Gmail Workspace…)
SMTP_URL=
MAIL_FROM=Mission Abundance <hello@missionabundance.com>

# Where the database lives (keep this on a persistent disk/volume)
DATA_DIR=./data

# Development only: simulate purchases without Stripe. Ignored when NODE_ENV=production.
DEV_FAKE_CHECKOUT=0
